{
    "y07":  {
                "tap":  0,
                "dur":  1486,
                "text":  "저장을 누르면,"
            },
    "y09":  {
                "tap":  974,
                "dur":  3368,
                "text":  "몇 달 뒤엔 검색창에 단어 하나, 큰방."
            },
    "s07":  {
                "tap":  1984,
                "dur":  2965,
                "text":  "PDF 한 권을 고르고 합치기를 누르면,"
            },
    "s08":  {
                "tap":  -1,
                "dur":  2955,
                "text":  "세 쪽짜리 PDF가 바로 완성됩니다."
            },
    "y11":  {
                "tap":  -1,
                "dur":  4427,
                "text":  "찍고 말하면 자막, 단어 하나로 검색. 세이캡."
            },
    "y02":  {
                "tap":  -1,
                "dur":  5309,
                "text":  "폰 속 수천 장 사진, 그 한 장 찾으려고 아직도 손가락으로 뒤지시나요?"
            },
    "y08":  {
                "tap":  1194,
                "dur":  3614,
                "text":  "저장한 뒤에도 수정 버튼으로 언제든 고칠 수 있어요."
            },
    "y10":  {
                "tap":  -1,
                "dur":  3526,
                "text":  "수천 장 중에서 그 사진만 한 방에 찾아 줍니다."
            },
    "s09":  {
                "tap":  -1,
                "dur":  3285,
                "text":  "종이 한 장도, 백 장도 폰 하나로 끝."
            },
    "y03":  {
                "tap":  -1,
                "dur":  3876,
                "text":  "2016년 특허 그대로, 찍고 말하면 끝입니다."
            },
    "s05":  {
                "tap":  1817,
                "dur":  2865,
                "text":  "원하는 페이지만 골라 따로 저장합니다."
            },
    "s06":  {
                "tap":  2531,
                "dur":  2978,
                "text":  "여러 장을 한 문서로 묶을 땐 연결하기."
            },
    "s04":  {
                "tap":  4688,
                "dur":  4374,
                "text":  "세 장이 바로 쌓였죠. 필요한 장만 쓰려면 분리하기."
            },
    "s10":  {
                "tap":  -1,
                "dur":  3099,
                "text":  "설치 없이 지금 무료로, 더스캔."
            },
    "s02":  {
                "tap":  6119,
                "dur":  5659,
                "text":  "더스캔은 모서리 맞추기도, 초점 기다리기도 없습니다. 찍기만 누르세요."
            },
    "y04":  {
                "tap":  1124,
                "dur":  3964,
                "text":  "새 세이캡은 내 사진 불러오기, 한 번이면 됩니다."
            },
    "y06":  {
                "tap":  -1,
                "dur":  4676,
                "text":  "말하는 동안 주황 이퀄라이저가 움직이고, 자막이 바로 새겨집니다."
            },
    "y05":  {
                "tap":  1288,
                "dur":  2890,
                "text":  "사진이 열리면 마이크를 누르고 말하세요."
            },
    "s03":  {
                "tap":  -1,
                "dur":  3898,
                "text":  "찍는 즉시 반듯하게 펴고, 그림자까지 지웁니다."
            },
    "s01":  {
                "tap":  -1,
                "dur":  3131,
                "text":  "종이 서류, 아직도 스캐너 찾으세요?"
            },
    "y01":  {
                "tap":  -1,
                "dur":  2875,
                "text":  "세이캡 카메라, 알고 계신가요?"
            }
}